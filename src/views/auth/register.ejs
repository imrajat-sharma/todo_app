<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head", { title }) %>
  </head>
  <body class="min-h-screen bg-canvas text-ink">
    <main class="mx-auto flex min-h-screen max-w-7xl flex-col px-5 py-6 sm:px-6">
      <%- include("../partials/navbar", { currentPath, currentUser }) %>

      <section class="mx-auto grid w-full max-w-6xl flex-1 gap-6 py-8 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="rounded-[2rem] border border-line bg-panel p-6 shadow-panel sm:p-8">
          <p class="text-sm font-semibold uppercase tracking-[0.24em] text-muted">New workspace</p>
          <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-ink">Create your account and start planning clearly.</h1>
          <p class="mt-4 max-w-lg text-base leading-7 text-muted">
            Set up a focused task workspace with compact task management, clear progress tracking, and practical daily structure.
          </p>

          <div class="mt-8 space-y-3">
            <div class="rounded-2xl border border-line bg-white p-4">
              <p class="text-sm text-muted">Designed for</p>
              <p class="mt-1 font-semibold text-ink">Quick capture, active work, and steady completion.</p>
            </div>
            <div class="rounded-2xl border border-line bg-white p-4">
              <p class="text-sm text-muted">Session model</p>
              <p class="mt-1 font-semibold text-ink">Secure cookies with access and refresh token flow.</p>
            </div>
          </div>
        </div>

        <div class="rounded-[2rem] border border-line bg-panel p-6 shadow-panel sm:p-8">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-2xl font-bold text-ink">Create account</h2>
              <p class="mt-1 text-sm text-muted">Everything you need to enter the workspace.</p>
            </div>
            <span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-semibold text-muted">Workspace</span>
          </div>

          <%- include("../partials/flash", { message, error }) %>

          <form action="/auth/register" method="POST" enctype="multipart/form-data" class="mt-6 grid gap-5">
            <div>
              <label for="profileImage" class="mb-2 block text-sm font-medium text-muted">Profile image</label>
              <input
                id="profileImage"
                name="profileImage"
                type="file"
                accept="image/*"
                class="w-full rounded-2xl border border-dashed border-line bg-white px-4 py-3 text-muted file:mr-4 file:rounded-xl file:border-0 file:bg-stone-900 file:px-4 file:py-2 file:font-medium file:text-stone-50"
              />
            </div>
            <div>
              <label for="name" class="mb-2 block text-sm font-medium text-muted">Full name</label>
              <input id="name" name="name" type="text" value="<%= values?.name || '' %>" required class="w-full rounded-2xl border border-line bg-white px-4 py-3 text-ink outline-none transition focus:border-stone-500" />
            </div>
            <div>
              <label for="username" class="mb-2 block text-sm font-medium text-muted">Username</label>
              <input id="username" name="username" type="text" value="<%= values?.username || '' %>" required class="w-full rounded-2xl border border-line bg-white px-4 py-3 text-ink outline-none transition focus:border-stone-500" />
            </div>
            <div>
              <label for="email" class="mb-2 block text-sm font-medium text-muted">Email</label>
              <input id="email" name="email" type="email" value="<%= values?.email || '' %>" required class="w-full rounded-2xl border border-line bg-white px-4 py-3 text-ink outline-none transition focus:border-stone-500" />
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="password" class="mb-2 block text-sm font-medium text-muted">Password</label>
                <input id="password" name="password" type="password" required class="w-full rounded-2xl border border-line bg-white px-4 py-3 text-ink outline-none transition focus:border-stone-500" />
              </div>
              <div>
                <label for="confirmPassword" class="mb-2 block text-sm font-medium text-muted">Confirm password</label>
                <input id="confirmPassword" name="confirmPassword" type="password" required class="w-full rounded-2xl border border-line bg-white px-4 py-3 text-ink outline-none transition focus:border-stone-500" />
              </div>
            </div>
            <button type="submit" class="w-full rounded-2xl bg-stone-900 px-5 py-3 font-semibold text-stone-50 transition hover:bg-stone-700">
              Create account
            </button>
          </form>

          <p class="mt-6 text-sm text-muted">
            Already registered?
            <a href="/auth/login" class="font-semibold text-ink underline decoration-stone-300 underline-offset-4">Sign in here</a>
          </p>
        </div>
      </section>
    </main>
  </body>
</html>
