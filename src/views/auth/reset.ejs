<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head", { title: "Password update" }) %>
  </head>
  <body class="min-h-screen bg-canvas text-ink">
    <main class="mx-auto flex min-h-screen max-w-3xl items-center justify-center px-5 py-10 sm:px-6">
      <div class="w-full rounded-[2rem] border border-line bg-panel p-8 text-center shadow-panel">
        <h1 class="text-3xl font-extrabold text-ink">Password management now lives inside the dashboard.</h1>
        <p class="mt-4 text-muted">
          Sign in to update your credentials securely from the authenticated account settings section.
        </p>
        <div class="mt-8 flex justify-center gap-4">
          <a href="/auth/login" class="rounded-2xl bg-stone-900 px-5 py-3 font-semibold text-stone-50 transition hover:bg-stone-700">Sign in</a>
          <a href="/auth/register" class="rounded-2xl border border-line bg-white px-5 py-3 font-semibold text-ink transition hover:bg-stone-100">Create account</a>
        </div>
      </div>
    </main>
  </body>
</html>
