<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("../partials/head", { title }) %>
  </head>
  <body class="min-h-screen bg-canvas text-ink">
    <main class="mx-auto min-h-screen max-w-7xl px-5 py-6 sm:px-6">
      <%- include("../partials/navbar", { currentPath, currentUser }) %>

      <section class="mt-6 space-y-6">
        <div class="grid gap-6 xl:grid-cols-[1.45fr_0.55fr]">
          <div class="rounded-[2rem] border border-line bg-panel p-5 shadow-panel sm:p-6">
            <%- include("../partials/flash", { message, error }) %>

            <div class="mt-1 flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
              <div>
                <p class="text-sm font-semibold uppercase tracking-[0.24em] text-muted">Today</p>
                <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-ink">Welcome back, <%= user.name %></h1>
                <p class="mt-2 text-sm leading-6 text-muted">Review active work, update priorities, and finish the next important task.</p>
              </div>

              <div class="flex items-center gap-4 rounded-3xl border border-line bg-white px-4 py-3">
                <div class="h-14 w-14 overflow-hidden rounded-2xl border border-line bg-stone-100">
                  <% if (user.profileImage) { %>
                    <img src="/uploads/<%= user.profileImage %>" alt="<%= user.name %>" class="h-full w-full object-cover" />
                  <% } else { %>
                    <div class="flex h-full w-full items-center justify-center text-lg font-semibold text-accentDark">
                      <%= user.name.charAt(0).toUpperCase() %>
                    </div>
                  <% } %>
                </div>
                <div>
                  <p class="font-semibold text-ink">@<%= user.username %></p>
                  <p class="text-sm text-muted"><%= user.email %></p>
                </div>
              </div>
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-1">
            <div class="rounded-[2rem] border border-line bg-panel p-5 shadow-panel">
              <p class="text-sm font-medium text-muted">Completion</p>
              <p class="mt-2 text-3xl font-extrabold text-ink"><%= stats.completionRate %>%</p>
              <div class="mt-4 h-2 overflow-hidden rounded-full bg-stone-200">
                <div class="h-full rounded-full bg-accent" style="width: <%= stats.completionRate %>%"></div>
              </div>
              <p class="mt-3 text-sm text-muted"><%= stats.completed %> of <%= stats.total %> tasks completed</p>
            </div>

            <div class="rounded-[2rem] border border-line bg-panel p-5 shadow-panel">
              <p class="text-sm font-medium text-muted">Quick summary</p>
              <div class="mt-4 grid grid-cols-3 gap-3 text-center">
                <div class="rounded-2xl bg-white p-3">
                  <p class="text-xs uppercase tracking-[0.18em] text-muted">Pending</p>
                  <p class="mt-1 text-2xl font-bold text-warn"><%= stats.pending %></p>
                </div>
                <div class="rounded-2xl bg-white p-3">
                  <p class="text-xs uppercase tracking-[0.18em] text-muted">Doing</p>
                  <p class="mt-1 text-2xl font-bold text-ink"><%= stats.inProgress %></p>
                </div>
                <div class="rounded-2xl bg-white p-3">
                  <p class="text-xs uppercase tracking-[0.18em] text-muted">Done</p>
                  <p class="mt-1 text-2xl font-bold text-success"><%= stats.completed %></p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid gap-6 xl:grid-cols-[1.45fr_0.55fr]">
          <div class="space-y-6">
            <div class="rounded-[2rem] border border-line bg-panel p-5 shadow-panel sm:p-6">
              <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                <div>
                  <h2 class="text-2xl font-bold text-ink">Tasks</h2>
                  <p class="text-sm text-muted">The main workspace for filtering, updating, and completing work.</p>
                </div>

                <div class="flex flex-wrap gap-3">
                  <div class="rounded-2xl bg-stone-100 px-3 py-2 text-sm font-medium text-muted">
                    <span class="text-ink"><%= stats.total %></span> total items
                  </div>
                  <div class="rounded-2xl bg-stone-100 px-3 py-2 text-sm font-medium text-muted">
                    <span class="text-ink"><%= stats.inProgress %></span> active
                  </div>
                </div>
              </div>

              <form method="GET" action="/dashboard" class="mt-5 grid gap-3 lg:grid-cols-[1.2fr_0.8fr_0.8fr_auto]">
                <input name="search" value="<%= filters.search %>" placeholder="Search title or description" class="rounded-2xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500" />
                <select name="status" class="rounded-2xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500">
                  <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All status</option>
                  <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
                  <option value="in_progress" <%= filters.status === 'in_progress' ? 'selected' : '' %>>In progress</option>
                  <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
                </select>
                <select name="priority" class="rounded-2xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500">
                  <option value="all" <%= filters.priority === 'all' ? 'selected' : '' %>>All priority</option>
                  <option value="low" <%= filters.priority === 'low' ? 'selected' : '' %>>Low</option>
                  <option value="medium" <%= filters.priority === 'medium' ? 'selected' : '' %>>Medium</option>
                  <option value="high" <%= filters.priority === 'high' ? 'selected' : '' %>>High</option>
                </select>
                <button type="submit" class="rounded-2xl bg-stone-900 px-4 py-3 text-sm font-semibold text-stone-50 transition hover:bg-stone-700">Apply</button>
              </form>

              <div class="mt-5 grid gap-3">
                <% if (!todos.length) { %>
                  <div class="rounded-3xl border border-dashed border-line bg-stone-50 p-8 text-center text-sm text-muted">
                    No tasks match your current filters.
                  </div>
                <% } %>

                <% todos.forEach((todo) => { %>
                  <div class="rounded-[1.75rem] border border-line bg-white p-4">
                    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-stone-200 pb-3">
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="rounded-full px-3 py-1 text-xs font-semibold <%= todo.status === 'completed' ? 'bg-emerald-100 text-emerald-800' : todo.status === 'in_progress' ? 'bg-stone-900 text-white' : 'bg-amber-100 text-amber-800' %>">
                          <%= todo.status === 'in_progress' ? 'In progress' : todo.status.charAt(0).toUpperCase() + todo.status.slice(1) %>
                        </span>
                        <span class="rounded-full px-3 py-1 text-xs font-semibold <%= todo.priority === 'high' ? 'bg-rose-100 text-rose-800' : todo.priority === 'medium' ? 'bg-stone-200 text-stone-700' : 'bg-stone-100 text-muted' %>">
                          <%= todo.priority.charAt(0).toUpperCase() + todo.priority.slice(1) %> priority
                        </span>
                        <% if (todo.dueDate) { %>
                          <span class="rounded-full bg-stone-100 px-3 py-1 text-xs font-semibold text-muted">
                            Due <%= new Date(todo.dueDate).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                          </span>
                        <% } %>
                      </div>

                      <div class="flex flex-wrap gap-2">
                        <form action="/todos/<%= todo._id %>/toggle" method="POST">
                          <button type="submit" class="rounded-2xl border border-line px-3 py-2 text-xs font-semibold text-muted transition hover:bg-stone-100 hover:text-ink">
                            <%= todo.status === 'completed' ? 'Mark pending' : 'Mark complete' %>
                          </button>
                        </form>
                        <form action="/todos/<%= todo._id %>/delete" method="POST">
                          <button type="submit" class="rounded-2xl border border-rose-200 px-3 py-2 text-xs font-semibold text-rose-700 transition hover:bg-rose-50">
                            Delete
                          </button>
                        </form>
                      </div>
                    </div>

                    <form action="/todos/<%= todo._id %>" method="POST" class="mt-4 grid gap-4">
                      <div class="grid gap-4 xl:grid-cols-[1.35fr_0.8fr_0.8fr_0.9fr]">
                        <div>
                          <label class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-muted">Task</label>
                          <input name="title" value="<%= todo.title %>" required class="w-full rounded-2xl border border-line bg-stone-50 px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500" />
                        </div>
                        <div>
                          <label class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-muted">Status</label>
                          <select name="status" class="w-full rounded-2xl border border-line bg-stone-50 px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500">
                            <option value="pending" <%= todo.status === 'pending' ? 'selected' : '' %>>Pending</option>
                            <option value="in_progress" <%= todo.status === 'in_progress' ? 'selected' : '' %>>In progress</option>
                            <option value="completed" <%= todo.status === 'completed' ? 'selected' : '' %>>Completed</option>
                          </select>
                        </div>
                        <div>
                          <label class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-muted">Priority</label>
                          <select name="priority" class="w-full rounded-2xl border border-line bg-stone-50 px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500">
                            <option value="low" <%= todo.priority === 'low' ? 'selected' : '' %>>Low</option>
                            <option value="medium" <%= todo.priority === 'medium' ? 'selected' : '' %>>Medium</option>
                            <option value="high" <%= todo.priority === 'high' ? 'selected' : '' %>>High</option>
                          </select>
                        </div>
                        <div>
                          <label class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-muted">Due date</label>
                          <input name="dueDate" type="date" value="<%= todo.dueDate ? new Date(todo.dueDate).toISOString().split('T')[0] : '' %>" class="w-full rounded-2xl border border-line bg-stone-50 px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500" />
                        </div>
                      </div>

                      <div>
                        <label class="mb-2 block text-xs font-semibold uppercase tracking-[0.18em] text-muted">Notes</label>
                        <textarea name="description" rows="2" class="w-full rounded-2xl border border-line bg-stone-50 px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500"><%= todo.description %></textarea>
                      </div>

                      <div class="flex justify-end">
                        <button type="submit" class="rounded-2xl bg-stone-900 px-4 py-2.5 text-sm font-semibold text-stone-50 transition hover:bg-stone-700">
                          Save changes
                        </button>
                      </div>
                    </form>
                  </div>
                <% }) %>
              </div>
            </div>
          </div>

          <div class="space-y-6">
            <div class="rounded-[2rem] border border-line bg-panel p-5 shadow-panel sm:p-6">
              <h2 class="text-lg font-bold text-ink">Quick capture</h2>
              <p class="mt-1 text-sm text-muted">Add a task fast, then refine it later inside the list.</p>

              <form action="/todos" method="POST" class="mt-5 grid gap-4">
                <div>
                  <label for="title" class="mb-2 block text-sm font-medium text-muted">Title</label>
                  <input id="title" name="title" type="text" required class="w-full rounded-2xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500" />
                </div>
                <div>
                  <label for="description" class="mb-2 block text-sm font-medium text-muted">Description</label>
                  <textarea id="description" name="description" rows="3" class="w-full rounded-2xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500"></textarea>
                </div>
                <div class="grid gap-3 sm:grid-cols-3 xl:grid-cols-1">
                  <div>
                    <label for="status" class="mb-2 block text-sm font-medium text-muted">Status</label>
                    <select id="status" name="status" class="w-full rounded-2xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500">
                      <option value="pending">Pending</option>
                      <option value="in_progress">In progress</option>
                      <option value="completed">Completed</option>
                    </select>
                  </div>
                  <div>
                    <label for="priority" class="mb-2 block text-sm font-medium text-muted">Priority</label>
                    <select id="priority" name="priority" class="w-full rounded-2xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500">
                      <option value="low">Low</option>
                      <option value="medium" selected>Medium</option>
                      <option value="high">High</option>
                    </select>
                  </div>
                  <div>
                    <label for="dueDate" class="mb-2 block text-sm font-medium text-muted">Due date</label>
                    <input id="dueDate" name="dueDate" type="date" class="w-full rounded-2xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500" />
                  </div>
                </div>
                <button type="submit" class="rounded-2xl bg-accent px-5 py-3 font-semibold text-white transition hover:bg-accentDark">
                  Add task
                </button>
              </form>
            </div>

            <div class="rounded-[2rem] border border-line bg-panel p-5 shadow-panel sm:p-6">
              <h2 class="text-lg font-bold text-ink">Account settings</h2>
              <p class="mt-1 text-sm text-muted">Secondary controls that stay available without distracting from the task list.</p>

              <form action="/dashboard/profile" method="POST" enctype="multipart/form-data" class="mt-5 grid gap-4">
                <div>
                  <label for="profileImage" class="mb-2 block text-sm font-medium text-muted">Profile image</label>
                  <input id="profileImage" name="profileImage" type="file" accept="image/*" class="w-full rounded-2xl border border-dashed border-line bg-white px-4 py-3 text-sm text-muted file:mr-4 file:rounded-xl file:border-0 file:bg-stone-900 file:px-4 file:py-2 file:font-medium file:text-stone-50" />
                </div>
                <div>
                  <label for="name" class="mb-2 block text-sm font-medium text-muted">Name</label>
                  <input id="name" name="name" type="text" value="<%= user.name %>" required class="w-full rounded-2xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500" />
                </div>
                <div>
                  <label for="username" class="mb-2 block text-sm font-medium text-muted">Username</label>
                  <input id="username" name="username" type="text" value="<%= user.username %>" required class="w-full rounded-2xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500" />
                </div>
                <div>
                  <label for="email" class="mb-2 block text-sm font-medium text-muted">Email</label>
                  <input id="email" name="email" type="email" value="<%= user.email %>" required class="w-full rounded-2xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500" />
                </div>
                <button type="submit" class="rounded-2xl border border-line bg-white px-5 py-3 font-semibold text-ink transition hover:bg-stone-100">
                  Save profile
                </button>
              </form>
            </div>

            <div class="rounded-[2rem] border border-line bg-panel p-5 shadow-panel sm:p-6">
              <h2 class="text-lg font-bold text-ink">Password</h2>
              <p class="mt-1 text-sm text-muted">Keep your workspace secure.</p>

              <form action="/auth/password" method="POST" class="mt-5 grid gap-4">
                <div>
                  <label for="currentPassword" class="mb-2 block text-sm font-medium text-muted">Current password</label>
                  <input id="currentPassword" name="currentPassword" type="password" required class="w-full rounded-2xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500" />
                </div>
                <div>
                  <label for="newPassword" class="mb-2 block text-sm font-medium text-muted">New password</label>
                  <input id="newPassword" name="newPassword" type="password" required class="w-full rounded-2xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500" />
                </div>
                <div>
                  <label for="confirmNewPassword" class="mb-2 block text-sm font-medium text-muted">Confirm new password</label>
                  <input id="confirmNewPassword" name="confirmNewPassword" type="password" required class="w-full rounded-2xl border border-line bg-white px-4 py-3 text-sm text-ink outline-none transition focus:border-stone-500" />
                </div>
                <button type="submit" class="rounded-2xl border border-line bg-white px-5 py-3 font-semibold text-ink transition hover:bg-stone-100">
                  Update password
                </button>
              </form>
            </div>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>
