<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head", { title }) %>
  </head>
  <body class="min-h-screen bg-canvas text-ink">
    <main class="mx-auto flex min-h-screen max-w-7xl flex-col px-5 py-6 sm:px-6">
      <%- include("partials/navbar", { currentPath, currentUser }) %>

      <section class="grid flex-1 gap-6 py-8 lg:grid-cols-[1.25fr_0.75fr]">
        <div class="rounded-[2rem] border border-line bg-panel p-6 shadow-panel sm:p-8">
          <div class="flex flex-wrap items-center gap-3 text-sm text-muted">
            <span class="rounded-full bg-stone-100 px-3 py-1 font-semibold text-stone-700">Focused workspace</span>
            <span>Daily planning</span>
            <span class="text-stone-300">/</span>
            <span>Task execution</span>
          </div>

          <div class="mt-8 grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
            <div>
              <h1 class="max-w-3xl text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
                A calm place to plan, sort, and finish your work.
              </h1>
              <p class="mt-5 max-w-2xl text-base leading-7 text-muted sm:text-lg">
                TaskFlow is a practical todo workspace with quick capture, meaningful task states, and a layout built for doing work instead of reading a marketing page.
              </p>
              <div class="mt-8 flex flex-wrap gap-3">
                <a href="/auth/register" class="rounded-2xl bg-accent px-5 py-3 font-semibold text-white transition hover:bg-accentDark">
                  Start organizing
                </a>
                <a href="/auth/login" class="rounded-2xl border border-line bg-white px-5 py-3 font-semibold text-ink transition hover:bg-stone-100">
                  Open workspace
                </a>
              </div>
            </div>

            <div class="rounded-[1.75rem] border border-line bg-stone-50 p-4">
              <div class="rounded-[1.4rem] border border-line bg-panel p-4">
                <div class="flex items-center justify-between">
                  <div>
                    <p class="text-sm font-semibold text-ink">Today</p>
                    <p class="text-sm text-muted">3 priorities, 2 in progress</p>
                  </div>
                  <span class="rounded-full bg-stone-900 px-3 py-1 text-xs font-semibold text-stone-50">Dashboard</span>
                </div>

                <div class="mt-4 space-y-3">
                  <div class="rounded-2xl border border-line bg-white p-4">
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <p class="font-semibold text-ink">Finalize weekly roadmap</p>
                        <p class="mt-1 text-sm text-muted">Review priorities, assign due dates, share update.</p>
                      </div>
                      <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-800">High</span>
                    </div>
                  </div>
                  <div class="rounded-2xl border border-line bg-white p-4">
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <p class="font-semibold text-ink">Clean up inbox tasks</p>
                        <p class="mt-1 text-sm text-muted">Move loose items into planned work.</p>
                      </div>
                      <span class="rounded-full bg-stone-900 px-2.5 py-1 text-xs font-semibold text-white">In progress</span>
                    </div>
                  </div>
                  <div class="rounded-2xl border border-dashed border-line bg-stone-50 p-4 text-sm text-muted">
                    Quick capture, compact filters, and lightweight settings live inside the same workspace.
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="mt-8 grid gap-4 md:grid-cols-3">
            <div class="rounded-3xl border border-line bg-white p-5">
              <p class="text-sm font-medium text-muted">Quick capture</p>
              <p class="mt-2 text-lg font-semibold text-ink">Add tasks without breaking flow</p>
            </div>
            <div class="rounded-3xl border border-line bg-white p-5">
              <p class="text-sm font-medium text-muted">Clear status</p>
              <p class="mt-2 text-lg font-semibold text-ink">Track pending, in progress, and completed work</p>
            </div>
            <div class="rounded-3xl border border-line bg-white p-5">
              <p class="text-sm font-medium text-muted">Quiet design</p>
              <p class="mt-2 text-lg font-semibold text-ink">A product UI that stays out of the way</p>
            </div>
          </div>
        </div>

        <aside class="space-y-4">
          <div class="rounded-[2rem] border border-line bg-panel p-6 shadow-panel">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-muted">How it feels</p>
            <div class="mt-4 space-y-4">
              <div class="rounded-2xl border border-line bg-white p-4">
                <p class="text-sm text-muted">Less noise</p>
                <p class="mt-1 font-semibold text-ink">Balanced spacing and softer surfaces for longer use.</p>
              </div>
              <div class="rounded-2xl border border-line bg-white p-4">
                <p class="text-sm text-muted">More control</p>
                <p class="mt-1 font-semibold text-ink">Task states, priorities, due dates, and quick edits in one place.</p>
              </div>
            </div>
          </div>
        </aside>
      </section>
    </main>
  </body>
</html>
