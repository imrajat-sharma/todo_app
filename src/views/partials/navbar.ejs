<nav class="flex items-center justify-between gap-4 rounded-3xl border border-line bg-panel/95 px-5 py-4 shadow-panel">
  <a href="/" class="flex items-center gap-3 text-ink">
    <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-accent text-sm font-bold uppercase tracking-[0.2em] text-white">TF</span>
    <span>
      <span class="block text-base font800 font-extrabold leading-none">TaskFlow</span>
      <span class="block text-xs font-medium text-muted">Personal task workspace</span>
    </span>
  </a>

  <div class="flex items-center gap-3 text-sm font-medium">
    <% if (currentUser) { %>
      <a href="/dashboard" class="rounded-2xl px-4 py-2.5 <%= currentPath === '/dashboard' ? 'bg-stone-900 text-stone-50' : 'text-muted hover:bg-stone-100 hover:text-ink' %>">
        Dashboard
      </a>
      <form action="/auth/logout" method="POST">
        <button type="submit" class="rounded-2xl border border-line px-4 py-2.5 text-muted transition hover:border-stone-400 hover:bg-stone-100 hover:text-ink">
          Logout
        </button>
      </form>
    <% } else { %>
      <a href="/auth/login" class="rounded-2xl px-4 py-2.5 <%= currentPath === '/auth/login' ? 'bg-stone-900 text-stone-50' : 'text-muted hover:bg-stone-100 hover:text-ink' %>">
        Login
      </a>
      <a href="/auth/register" class="rounded-2xl border border-line bg-stone-100 px-4 py-2.5 text-ink transition hover:border-stone-400 hover:bg-stone-200">
        Register
      </a>
    <% } %>
  </div>
</nav>
